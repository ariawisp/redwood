package redwood:protocol;

interface protocol {
  /// Logical node identifier.
  type node-id = u64;

  /// Schema-qualified widget identifier.
  type widget-tag = u32;

  /// Identifies a property on a widget.
  type property-tag = u32;

  /// Identifies a child slot on a widget.
  type children-tag = u32;

  /// Identifies a modifier applied to a widget. May be negative for reserved tags.
  type modifier-tag = s32;

  /// Identifies an event emitted by a widget.
  type event-tag = u32;

  /// Payload for create widget operations.
  record change-create {
    id: node-id,
    widget: widget-tag,
  }

  /// Payload for destroy widget operations.
  record change-destroy {
    id: node-id,
  }

  /// Payload for adding a child to a slot at an index.
  record change-add-child {
    parent: node-id,
    slot: children-tag,
    child: node-id,
    index: u32,
  }

  /// Payload for moving a range of children.
  record change-move-child {
    parent: node-id,
    slot: children-tag,
    from: u32,
    to: u32,
    count: u32,
  }

  /// Payload for removing a child range.
  record change-remove-child {
    parent: node-id,
    slot: children-tag,
    index: u32,
    count: u32,
    detach: bool,
  }

  /// Payload for property updates, encoded as JSON.
  record change-set-property {
    id: node-id,
    widget: widget-tag,
    property: property-tag,
    value-json: string,
  }

  /// A modifier element applied to a widget. `value-json` is omitted when default/null.
  record modifier-element {
    tag: modifier-tag,
    value-json: option<string>,
  }

  /// Payload for modifier updates.
  record change-set-modifiers {
    id: node-id,
    elements: list<modifier-element>,
  }

  /// A single UI mutation.
  variant redwood-change {
    create(change-create),
    destroy(change-destroy),
    add-child(change-add-child),
    move-child(change-move-child),
    remove-child(change-remove-child),
    set-property(change-set-property),
    set-modifiers(change-set-modifiers),
  }

  /// A batch of UI mutations.
  record redwood-frame {
    changes: list<redwood-change>,
  }

  /// A runtime event emitted by the host for a widget instance.
  record redwood-event {
    id: node-id,
    widget: widget-tag,
    event: event-tag,
    args-json: list<string>,
  }
}
